          "stringUnit" : {
            "state" : "translated",
            "value" : "ZENO"
          }
        }
      }
    },
    "ZENO acompaña tu día. No diagnostica ni reemplaza un tratamiento." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZENO keeps you company through the day. It doesn't diagnose or replace treatment."
          }
        }
      }
    },
    "ZENO acompaña tu día. No diagnostica ni reemplaza un tratamiento. Si algo te preocupa, habla con un profesional de salud." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZENO keeps you company through the day. It does not diagnose or replace treatment. If something worries you, talk to a health professional."
          }
        }
      }
    },
    "ZENO dejará de pedirla al entrar." : {
