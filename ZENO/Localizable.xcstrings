          "stringUnit" : {
            "state" : "translated",
            "value" : "There's no rush."
          }
        }
      }
    },
    "No pude escucharte esta vez. Puedes escribir." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I couldn't hear you this time. You can type instead."
          }
        }
      }
    },
    "No se pudo confirmar que eres tú. Inténtalo otra vez o escribe tu clave." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't confirm it's you. Try again or enter your password."
          }
        }
      }
    },
    "No se pudo entrar con Apple. Revisa tu conexión o entra como invitado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't sign in with Apple. Check your connection or continue as a guest."
