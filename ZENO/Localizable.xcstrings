    "Nació contigo, %@. Nadie más tiene una igual." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "She was born with you, %@. No one else has one like her."
          }
        }
      }
    },
    "Nada aquí. Está bien." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing here. That's okay."
