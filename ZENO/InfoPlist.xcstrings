    "NSFaceIDUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZENO uses Face ID only so you can get in or recover your password. Nothing leaves your phone."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZENO uses the microphone only while you press and hold Lumi, to write the task you say."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ZENO turns your voice into text on your phone to add tasks. Your voice never leaves the device."
          }
        }
      }
    }
  },
  "version": "1.0"
}